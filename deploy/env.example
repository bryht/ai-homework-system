# Dedicated database and user in the existing Postgres (see postgres-setup.sql).
# Postgres on the host:            postgres://ai_homework:<password>@host.docker.internal:5432/ai_homework
# Postgres in Docker on a network: postgres://ai_homework:<password>@<container name>:5432/ai_homework
DATABASE_URL=

DEEPSEEK_API_KEY=

# Web app on GitHub Pages
CORS_ORIGINS=https://bryht.github.io

# The gateway serves HTTPS, so cookies can be marked secure.
COOKIE_SECURE=true
APP_TIMEZONE=UTC
RUST_LOG=info,sqlx=warn
