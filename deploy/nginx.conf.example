# Add to the existing nginx. Two options; use one.

# --- Option A: a subdomain, e.g. homework-api.example.com ---
server {
    listen 443 ssl;
    http2 on;
    server_name homework-api.example.com;
    # ssl_certificate / ssl_certificate_key: same as the other sites (certbot etc.)

    location / {
        include /etc/nginx/snippets/ai-homework-proxy.conf;
        proxy_pass http://127.0.0.1:8787;
    }
}

# --- Option B: a path on an existing domain, e.g. https://example.com/homework/ ---
# Inside the existing server { } block. The trailing slashes strip the /homework prefix.
# Set the GitHub variable API_ORIGIN to https://example.com/homework
#
# location /homework/ {
#     include /etc/nginx/snippets/ai-homework-proxy.conf;
#     proxy_pass http://127.0.0.1:8787/;
# }

# --- /etc/nginx/snippets/ai-homework-proxy.conf ---
# proxy_http_version 1.1;
# proxy_set_header Host $host;
# proxy_set_header X-Forwarded-Host $host;
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# proxy_set_header X-Forwarded-Proto $scheme;
# # AI replies stream as server-sent events: no buffering, long reads
# proxy_buffering off;
# proxy_cache off;
# proxy_read_timeout 300s;
# # uploads up to 30 MB
# client_max_body_size 32m;
