# Copy to .env. docker compose reads it automatically; `cargo run` in apps/server reads it too.

# AI models. Without any key only the mock model is available.
# DeepSeek's own API:
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Ollama: every chat model on the account is offered; teachers pick one per homework.
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com

# Only needed when running the server outside Docker (`cargo run`); compose sets its own.
DATABASE_URL=postgres://homework:homework@localhost:5432/homework

# Web app hosted on another origin (GitHub Pages): comma-separated list of allowed origins.
# CORS_ORIGINS=https://bryht.github.io

# Time zone used to count "active days" in teacher statistics.
# APP_TIMEZONE=Europe/London
# Set to true when the site is served over HTTPS.
# COOKIE_SECURE=false
# SESSION_DAYS=14
# Keep the mock model available even when a real model is configured.
# ENABLE_MOCK_AI=false
# PORT=8787
