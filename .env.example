# 复制为 .env 后按需修改。后端启动时会读取（也可以直接设置环境变量）。

# DeepSeek API Key。不设置时只有「模拟模型」可用。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 设置后使用 Postgres（Neon / Supabase / 自建）；不设置时使用 PGlite，数据存在 DATA_DIR
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# PGlite 数据库和上传文件的目录，默认是仓库根目录下的 .data
# DATA_DIR=/var/lib/ai-homework

# PORT=8787
# 统计「活跃天数」时使用的时区
# APP_TIMEZONE=Europe/London
# 登录有效期（天）
# SESSION_DAYS=14
# 配置了真实模型后，是否仍保留模拟模型（默认 false）
# ENABLE_MOCK_AI=false
# 生产环境默认 true；本地用 http 访问时保持 false
# COOKIE_SECURE=false
